# billing-service — copy to .env (gitignored)
# DB shared with platform root (see ../../.env.example)
# NEVER commit real keys. See docs/secrets-management.md.
DB_URL=postgres://laststate:REPLACE_ME_postgres@postgres:5432/billing?sslmode=disable
TRACE_URL=http://localhost:8080
# Real keys (never commit) — replace every REPLACE_ME_... before staging/prod.
STRIPE_KEY=REPLACE_ME_stripe_sk_test_or_sk_live
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec_openssl_rand_hex_24
MP_KEY=REPLACE_ME_APP_USR_mercadopago_access_token
MP_WEBHOOK_SECRET=REPLACE_ME_mp_webhook_openssl_rand_hex_24
CRYPTO_KEY=REPLACE_ME_coinbase_commerce_api_key
CRYPTO_WEBHOOK_SECRET=REPLACE_ME_crypto_webhook_openssl_rand_hex_24
NOWPAYMENTS_KEY=REPLACE_ME_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=REPLACE_ME_nowpayments_ipn_openssl_rand_hex_24
BILLING_PORT=8080
BILLING_LOG_LEVEL=debug
# Dunning
BILLING_DUNNING_ENABLED=false
BILLING_DUNNING_INTERVAL=1h
BILLING_DUNNING_MAX_ATTEMPTS=5
BILLING_DUNNING_SUSPEND_AFTER_DAYS=14
BILLING_DUNNING_EMAIL_ENABLED=true
BILLING_DUNNING_SMS_ENABLED=true
BILLING_DUNNING_WEBHOOK_ENABLED=true
BILLING_EMAIL_SERVICE_URL=
BILLING_DUNNING_WEBHOOK_URL=
SMS_GATEWAY_URL=
# Trial sweeper (converge expired trials)
BILLING_TRIAL_SWEEP_INTERVAL=1h
# Usage billing cycle (monthly base + overage invoices per active
# subscription). OFF by default — enable on ONE instance only.
BILLING_USAGE_BILLING_ENABLED=false
# Transactional email (SMTP; unset = log transport)
BILLING_SMTP_HOST=
BILLING_SMTP_PORT=587
BILLING_SMTP_USER=
BILLING_SMTP_PASS=
BILLING_SMTP_FROM=billing@laststate.dev
BILLING_SMTP_TLS=false
# Entitlement HMAC (must match trace TRACE_BILLING_HMAC_SECRET)
TRACE_BILLING_HMAC_SECRET=REPLACE_ME_hmac_openssl_rand_base64_32
# Hosted checkout (POST /v1/billing/checkout) - Stripe Price IDs from the
# dashboard (test mode first, live on go-live). See docs/CHECKOUT.md.
# Unset = checkout fails closed naming the missing variable. No keys here.
BILLING_PRICE_POC=price_replace_me_poc_onetime_499
BILLING_PRICE_PILOT=price_replace_me_pilot_499mo
BILLING_PRICE_FLEET=price_replace_me_fleet_1999mo
BILLING_PRICE_ENTERPRISE=price_replace_me_enterprise_7999mo
BILLING_CHECKOUT_SUCCESS_URL=https://app.laststate.io/billing/success
BILLING_CHECKOUT_CANCEL_URL=https://app.laststate.io/billing/cancel

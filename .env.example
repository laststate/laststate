# LastState Platform — Environment (root docker-compose)
# Copy to .env at repository root:  cp .env.example .env
# NEVER commit .env. Generate secrets with:
#   bash scripts/generate-secrets.sh   (or: pwsh -File scripts/generate-secrets.ps1)
#   openssl rand -hex 32  /  openssl rand -base64 32
#
# How this works:
# - docker-compose.yml uses ${VAR:-dev_default} so the stack boots WITHOUT a
#   .env file for local development only.
# - Every value below that ends in _REPLACE_ME_... MUST be replaced before
#   any staging/production deploy. scripts/preflight-secrets.sh fails the
#   deploy if a placeholder or known-weak dev default is still present.
# - In production inject via a secret manager (Vault / AWS SSM / Doppler /
#   1Password Connect) — never bake real keys into images or git.

# ─── PostgreSQL ───
POSTGRES_USER=laststate
# 48+ hex chars. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_ME_postgres_openssl_rand_hex_24
POSTGRES_MULTIPLE_DATABASES=trace,billing

# ─── MinIO (S3 local) ───
MINIO_ROOT_USER=minio
# Min 12 chars. Generate: openssl rand -base64 18
MINIO_ROOT_PASSWORD=REPLACE_ME_minio_openssl_rand_base64_18
MINIO_BUCKET=trace

# ─── Trace ───
TRACE_MODE=all
TRACE_QUEUE=postgres
# Format: postgres://USER:PASSWORD@postgres:5432/trace?sslmode=disable
# Must reuse POSTGRES_USER/POSTGRES_PASSWORD above.
TRACE_DATABASE_URL=postgres://laststate:REPLACE_ME_postgres@postgres:5432/trace?sslmode=disable
# Format: lst_ingest_<rand>. Generate: openssl rand -hex 24 (prefix lst_ingest_)
TRACE_BOOTSTRAP_TOKEN=REPLACE_ME_lst_ingest_openssl_rand_hex_24
# 32+ bytes. Generate: openssl rand -base64 32
TRACE_JWT_SECRET=REPLACE_ME_jwt_openssl_rand_base64_32
TRACE_SECRETS_KEY=REPLACE_ME_secrets_openssl_rand_base64_32
TRACE_ADMIN_EMAIL=admin@laststate.local
# Local-dev only. Production: provision via IdP/SSO, never reuse.
TRACE_ADMIN_PASSWORD=REPLACE_ME_admin_openssl_rand_base64_18
TRACE_ENV=local
TRACE_DEPLOYMENT=local
TRACE_PUBLIC_URL=http://localhost:8080
TRACE_S3_ENDPOINT=http://minio:9000
TRACE_S3_BUCKET=trace
TRACE_S3_REGION=us-east-1
TRACE_S3_ACCESS_KEY=minio
TRACE_S3_SECRET_KEY=REPLACE_ME_minio_openssl_rand_base64_18

# ─── Relay ───
RELAY_DATA_DIR=/var/lib/laststate
RELAY_LOG_LEVEL=debug
LASTSTATE_INGEST_TOKEN=REPLACE_ME_relay_ingest_openssl_rand_hex_24
LASTSTATE_ADMIN_TOKEN=REPLACE_ME_relay_admin_openssl_rand_hex_24
LASTSTATE_COMPANY_TOKEN=REPLACE_ME_lst_ingest_openssl_rand_hex_24

# ─── Billing ───
BILLING_PORT=8080
# Stripe live/test keys come from the Stripe dashboard; test keys start sk_test_.
STRIPE_KEY=REPLACE_ME_stripe_sk_test_or_sk_live
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec_openssl_rand_hex_24
# Mercado Pago access token (APP_USR-...) from https://www.mercadopago.com/developers
MP_KEY=REPLACE_ME_APP_USR_mercadopago_access_token
MP_WEBHOOK_SECRET=REPLACE_ME_mp_webhook_openssl_rand_hex_24
# Coinbase Commerce API key (X-CC-Api-Key)
CRYPTO_KEY=REPLACE_ME_coinbase_commerce_api_key
CRYPTO_WEBHOOK_SECRET=REPLACE_ME_crypto_webhook_openssl_rand_hex_24
# NOWPayments API key (x-api-key) + IPN secret — https://nowpayments.io
NOWPAYMENTS_KEY=REPLACE_ME_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=REPLACE_ME_nowpayments_ipn_openssl_rand_hex_24

# ─── Billing realtime (shared across trace/relay/simulator/CLI) ───
# billing-service base URL inside compose: http://billing:8080
# (host-local: http://localhost:8081). Bearer key for /v1.
BILLING_URL=http://billing:8080
BILLING_API_KEY=REPLACE_ME_billing_openssl_rand_hex_24
# Org all usage/entitlement calls are scoped to (uuid).
BILLING_ORG_ID=REPLACE_ME_org_uuid
# Shared HMAC: trace admin API + v2 webhook receivers (trace, website).
# Generate: openssl rand -hex 32. Must match on both sides.
TRACE_BILLING_HMAC_SECRET=REPLACE_ME_hmac_openssl_rand_hex_32
# Trace live link (defaults to the compose billing service).
TRACE_BILLING_URL=http://billing:8080

# ─── Simulator ───
RELAY_URL=http://relay:8384
SIM_TCP_ADDR=relay:8385
SIM_UDP_ADDR=relay:8386
SIMULATOR_RATE=4
SIMULATOR_BATCH_SIZE=5
SIMULATOR_DEVICE_COUNT=5
SIMULATOR_ERROR_RATE=0.35
SIM_SCENARIO=demo

# ─── Observability ───
GF_SECURITY_ADMIN_USER=admin
# Production: set a unique password via secret manager.
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME_grafana_openssl_rand_base64_18

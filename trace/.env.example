# LastState Trace Environment Configuration
# Copy this file to .env and adjust values for your environment

# ============================================================================
# Core Configuration
# ============================================================================

# Database URL (required)
# Format: postgresql://user:password@host:port/database
TRACE_DATABASE_URL=postgresql://trace:trace@localhost:5432/trace

# Mock mode (set to true to use in-memory mock data, no DB required)
TRACE_MOCK=true

# Server port
TRACE_PORT=8080

# Log level (debug, info, warn, error)
TRACE_LOG_LEVEL=info

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT secret for token signing (change in production!)
# Generate with: openssl rand -hex 32
TRACE_JWT_SECRET=change-me-in-production

# OIDC configuration (optional, for SSO)
TRACE_OIDC_ISSUER=
TRACE_OIDC_CLIENT_ID=
TRACE_OIDC_CLIENT_SECRET=

# Rate limiting
TRACE_RATE_LIMIT_PER_MIN=600
TRACE_RATE_LIMIT_PER_IP=64

# ============================================================================
# Feature Flags
# ============================================================================

# Chaos Engineering
CHAOS_ENABLED=false
CHAOS_ADAPTER=serial
CHAOS_TIMEOUT_SEC=30

# Public API
PUBLIC_CRASH_API=true
PUBLIC_API_RATE_LIMIT=100

# Soundboard
SOUNDBOARD_ENABLED=true
SOUNDBOARD_VOLUME=50

# Device DNA
DNA_DETECTION_THRESHOLD=95

# Fleet Health
FLEET_HEALTH_RECALC_INTERVAL_MIN=15

# Postmortem Generation
TRACE_POSTMORTEM_API_KEY=
TRACE_POSTMORTEM_MAX_FREE=10

# GitHub Integration (for PR creation)
TRACE_GITHUB_TOKEN=
TRACE_GITHUB_REPO=
TRACE_GITHUB_DEFAULT_BRANCH=main

# Anomaly Detection
ANOMALY_ENABLED=false

# Memorial Wall
MEMORIAL_ENABLED=true

# ============================================================================
# Storage & External Services
# ============================================================================

# S3/MinIO for artifact storage (optional)
TRACE_S3_ENDPOINT=
TRACE_S3_ACCESS_KEY=
TRACE_S3_SECRET_KEY=
TRACE_S3_BUCKET=

# Queue backend (memory, redis, nats)
TRACE_QUEUE_BACKEND=memory
TRACE_REDIS_URL=
TRACE_NATS_URL=

# Notification services
TRACE_PAGERDUTY_KEY=
TRACE_SLACK_WEBHOOK=
TRACE_DISCORD_WEBHOOK=

# ============================================================================
# Billing & Payments
# ============================================================================

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (optional, for Brazil)
MERCADO_PAGO_ACCESS_TOKEN=

# Coinbase Commerce (optional, for crypto)
COINBASE_COMMERCE_KEY=

# ============================================================================
# Analytics & Monitoring
# ============================================================================

# ClickHouse (optional, for analytics export)
CLICKHOUSE_URL=

# BigQuery (optional)
GOOGLE_APPLICATION_CREDENTIALS=

# Metrics endpoint
TRACE_METRICS_ENABLED=true

# ============================================================================
# Deployment
# ============================================================================

# Deployment mode: "local" (self-hosted — everything unlocked) or
# "enterprise" (managed LastState SaaS — auth, quotas, billing/paywall).
# Default: enterprise.
#
#   local      → the person running the server is trusted: UI has no mandatory
#                auth, quotas/billing are disabled, paywall is hidden.
#                Forces TRACE_OPEN_UI=true and TRACE_ALLOW_PUBLIC_REGISTER=true.
#   enterprise → auth required, quotas enforced, billing/paywall shown.
#
# To self-host with everything unlocked, set:
#   TRACE_DEPLOYMENT=local
TRACE_DEPLOYMENT=enterprise

# Environment (development, staging, production)
TRACE_ENV=development

# CORS origins (comma-separated)
TRACE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Security & Hardening (production recommended)
# ============================================================================

# Trusted proxy IPs for X-Forwarded-For validation (comma-separated CIDRs)
# Ignore XFF unless peer matches one of these ranges.
TRACE_TRUSTED_PROXIES=

# AES-256-GCM key (32 bytes base64) for encrypting channel and alert secrets at rest.
# Generate with: openssl rand -base64 32
TRACE_SECRETS_KEY=

# Force secure cookies (true when TRACE_PUBLIC_URL uses https)
TRACE_COOKIE_SECURE=

# Allow unauthenticated self-registration (set false in production)
TRACE_ALLOW_PUBLIC_REGISTER=false

# Auto-join OIDC groups on login (set false in production)
TRACE_OIDC_AUTO_JOIN=false

# Allow unsigned SAML ACS responses (experimental — keep false in production)
TRACE_SAML_INSECURE=false

# HIBP breached-password check (k-anonymity, fail-open; local blocklist always on)
# Opt-in: set true to query api.pwnedpasswords.com/range/{prefix5} (3s timeout).
HIBP_CHECK=false

# Idle session expiry (Go duration; 0 disables). Enforced lazily per-request.
TRACE_SESSION_IDLE_TIMEOUT=24h

# ============================================================================
# Notes
# ============================================================================
#
# 1. Start with TRACE_MOCK=true to run without a database
# 2. Set TRACE_MOCK=false and provide TRACE_DATABASE_URL for production
# 3. Enable features by setting their respective flags to true
# 4. Never commit .env to version control
# 5. Use different .env files for different environments
# 6. Generate secrets with: openssl rand -hex 32
#

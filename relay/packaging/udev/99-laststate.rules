# Grant the laststate group access to common USB-serial adapters used with Latch.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", MODE="0660", GROUP="laststate"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", MODE="0660", GROUP="laststate"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", MODE="0660", GROUP="laststate"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", MODE="0660", GROUP="laststate"

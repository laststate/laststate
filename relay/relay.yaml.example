version: 1

instance:
  id: auto
  name: lab-relay
  data_dir: ./data

sources:
  - id: stm32-uart
    type: serial
    enabled: false
    serial:
      device: COM5
      baud: 115200
      reconnect: true
      reconnect_min: 1s
      reconnect_max: 30s
      read_timeout: 1s
    framing:
      type: latch-stream
      max_frame_bytes: 4194304
      partial_timeout: 30s
    ack:
      mode: lsak-v1
      write_timeout: 2s

  - id: field-imports
    type: directory
    enabled: true
    directory:
      path: ./inbox
      archive_path: ./imported
      quarantine_path: ./quarantine
      poll_interval: 2s
      stable_for: 1s
      max_files_per_poll: 100
    framing:
      type: latch-stream
    ack:
      mode: none

  - id: local-devices
    type: tcp
    enabled: false
    tcp:
      listen: 127.0.0.1:8382
      max_clients: 64
      read_timeout: 2m
      write_timeout: 10s
      tls:
        enabled: false
    framing:
      type: latch-stream
    ack:
      mode: lsak-v1

  - id: local-udp
    type: udp
    enabled: false
    udp:
      listen: 127.0.0.1:8385
      max_datagram_bytes: 65507
      allowed_cidrs:
        - 127.0.0.0/8
    framing:
      type: raw
    ack:
      mode: none

  - id: local-http
    type: http
    enabled: false
    http:
      listen: 127.0.0.1:8384
      token: env:LASTSTATE_INGEST_TOKEN
      max_body_bytes: 4194304
      max_concurrent: 32
      requests_per_second: 0 # 0 disables per-IP token bucket; e.g. 50
      burst_size: 0 # defaults to requests_per_second when 0
      rate_limit_max_keys: 10000
      read_timeout: 15s
      write_timeout: 30s
      idle_timeout: 1m
      tls:
        enabled: false
    framing:
      type: raw
    ack:
      mode: none

  - id: factory-mqtt
    type: mqtt
    enabled: false
    mqtt:
      broker: tls://mqtt.example.com:8883
      client_id: lab-relay
      topics:
        - latch/+/events
      qos: 1
      username: env:MQTT_USER
      password: env:MQTT_PASS
      tls:
        enabled: true
    framing:
      type: raw

  - id: can-adapter
    type: adapter
    enabled: false
    adapter:
      command: /usr/local/bin/ls-can-adapter
      args: ["--iface", "can0"]
    framing:
      type: raw

  # Experimental transports — require platform support (BlueZ, SocketCAN,
  # LoRaWAN network server) and are not yet recommended for production.
  - id: can0
    type: can
    enabled: false
    can:
      interface: can0
      baudrate: 500000
      fd_enabled: false
      brs: false
      protocol: LEP
    framing:
      type: raw

  - id: ble-sensor
    type: ble
    enabled: false
    ble:
      adapter: hci0
      scan_duration: 30s
      service_uuid: 0000fff0-0000-1000-8000-00805f9b34fb
      char_uuid: 0000fff1-0000-1000-8000-00805f9b34fb
      notify_enabled: true
      rssi_threshold: -80
      max_devices: 50
    framing:
      type: raw

  - id: lorawan-gateway
    type: lorawan
    enabled: false
    lorawan:
      server: ttn.example.com:1883
      protocol: MQTT
      network_id: "0000000000000001"
      device_eui: "0000000000000001"
      tls_enabled: true
      max_retries: 3
    framing:
      type: raw

destinations:
  - id: trace-local
    type: trace
    enabled: false
    required: false
    priority: 10
    url: http://127.0.0.1:8080
    auth:
      type: none
    batch:
      enabled: false
      max_events: 100
      max_bytes: 4194304
      max_wait: 2s
      prefer_binary: false
      prefer_zstd: true

  - id: company-trace
    type: trace
    enabled: false
    required: true
    priority: 20
    url: https://trace.example.com
    auth:
      type: bearer
      token: env:LASTSTATE_COMPANY_TOKEN
    tls:
      ca_file: ""
      cert_file: ""
      key_file: ""
      server_name: ""
      insecure_skip_verify: false

  - id: laststate-cloud
    type: trace
    enabled: false
    required: false
    priority: 30
    url: https://ingest.laststate.dev
    auth:
      type: bearer
      token: file:/run/secrets/laststate-cloud-token

delivery:
  mode: mirror # mirror, priority, route, local-only
  concurrency: 4
  retry:
    min_delay: 1s
    max_delay: 15m
    multiplier: 2
    jitter: true
    max_attempts: 50
  circuit_breaker:
    failure_threshold: 5
    open_for: 30s
  routes: []

spool:
  max_bytes: 10737418240
  min_free_bytes: 268435456
  delivered_retention: 720h
  pressure_policy: reject-new
  fsync: full

admin:
  listen: 127.0.0.1:8383
  token: env:LASTSTATE_ADMIN_TOKEN
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 1m
  tls:
    enabled: false

metrics:
  enabled: true
  listen: 127.0.0.1:9467

analysis:
  enabled: true
  llvm_symbolizer: ""
  arm_addr2line: ""
  riscv_addr2line: ""
  source_path_prefix: ""
  source_path_maps: []
  symbol_cache_dir: ./data/symbol-cache
  memory_map: []
  # memory_map example:
  # - name: flash
  #   start: 0x08000000
  #   end: 0x08100000
  #   class: flash

artifacts:
  directory: ./data/artifacts
  auto_discover: []

crypto:
  enabled: false
  active_key_id: ""
  auth_key_id: ""
  decrypt_on_ingest: false
  allow_opaque_forward: true
  replay_window: 10000
  keys: []
  # keys:
  #   - id: device-1
  #     key: env:RELAY_KEY_DEVICE1

privacy:
  preserve_raw_locally: true
  destinations:
    laststate-cloud:
      # TLV IDs are defined by the protocol repository. The raw local event is
      # never modified; Relay derives a destination-specific copy.
      drop_tlv_types: []
      max_payload_bytes: 0
      block_encrypted: false
